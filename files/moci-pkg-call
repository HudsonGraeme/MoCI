#!/bin/sh

action=$1
shift

if [ -f /usr/bin/apk ]; then
	pm="apk"
else
	pm="opkg"
fi

valid_name() {
	echo "$1" | grep -qE '^moci-addon-[a-z0-9][a-z0-9-]*$'
}

FEED_CONF_OPKG=/etc/opkg/moci-addons.conf
FEED_CONF_APK=/etc/apk/repositories.d/moci-addons.list

valid_feed_name() {
	echo "$1" | grep -qE '^[a-z0-9][a-z0-9_-]*$'
}

valid_feed_url() {
	echo "$1" | grep -qE '^https://[A-Za-z0-9._~:/?#@!$&()*+,;=%-]+$'
}

case "$action" in
	list-present)
		for d in /www/moci/js/addons/*/; do
			[ -f "${d}manifest.json" ] && basename "$d"
		done
		:
		;;
	list-installed)
		if [ "$pm" = "apk" ]; then
			apk list -I 2>/dev/null | grep '^moci-addon-' | sed 's/^\(moci-addon-[a-z0-9-]*\)-[0-9][^ ]*.*/\1/' || true
		else
			opkg list-installed 2>/dev/null | grep '^moci-addon-' | awk '{print $1}' || true
		fi
		;;
	list-available)
		if [ "$pm" = "apk" ]; then
			apk list 2>/dev/null | grep '^moci-addon-' | sed 's/^\(moci-addon-[a-z0-9-]*\)-\([0-9][^ ]*\).*/\1 - \2/' || true
		else
			opkg list 2>/dev/null | grep '^moci-addon-' || true
		fi
		;;
	update)
		if [ "$pm" = "apk" ]; then
			apk update
		else
			opkg update
		fi
		;;
	feeds)
		if [ "$pm" = "apk" ]; then
			[ -f "$FEED_CONF_APK" ] && cat "$FEED_CONF_APK"
		else
			[ -f "$FEED_CONF_OPKG" ] && cat "$FEED_CONF_OPKG"
		fi
		:
		;;
	feed-add)
		name=$1
		url=$2
		valid_feed_name "$name" || { echo "invalid feed name" >&2; exit 1; }
		valid_feed_url "$url" || { echo "invalid feed url (https only)" >&2; exit 1; }
		if [ "$pm" = "apk" ]; then
			mkdir -p "$(dirname "$FEED_CONF_APK")"
			grep -qxF "$url" "$FEED_CONF_APK" 2>/dev/null && { echo "feed already configured" >&2; exit 1; }
			echo "$url" >> "$FEED_CONF_APK"
		else
			grep -qE "^src/gz $name " "$FEED_CONF_OPKG" 2>/dev/null && { echo "feed name already in use" >&2; exit 1; }
			echo "src/gz $name $url" >> "$FEED_CONF_OPKG"
		fi
		;;
	feed-remove)
		if valid_feed_name "$1"; then
			[ -f "$FEED_CONF_OPKG" ] || exit 0
			tmp="$FEED_CONF_OPKG.tmp.$$"
			grep -vE "^src/gz $1 " "$FEED_CONF_OPKG" > "$tmp"
			mv "$tmp" "$FEED_CONF_OPKG"
		elif valid_feed_url "$1"; then
			[ -f "$FEED_CONF_APK" ] || exit 0
			tmp="$FEED_CONF_APK.tmp.$$"
			grep -vxF "$1" "$FEED_CONF_APK" > "$tmp"
			mv "$tmp" "$FEED_CONF_APK"
		else
			echo "invalid feed identifier" >&2
			exit 1
		fi
		;;
	inspect)
		valid_name "$1" || { echo "invalid addon name" >&2; exit 1; }
		tmp=$(mktemp -d) || exit 1
		(
			cd "$tmp" || exit 1
			if [ "$pm" = "apk" ]; then
				apk fetch -q "$1" >/dev/null 2>&1 || exit 1
				pkg=$(ls "$1"*.apk 2>/dev/null | head -n1)
				[ -n "$pkg" ] || exit 1
				mkdir -p d
				apk extract --destination d "$pkg" >/dev/null 2>&1 || exit 1
			else
				opkg download "$1" >/dev/null 2>&1 || exit 1
				pkg=$(ls "$1"*.ipk 2>/dev/null | head -n1)
				[ -n "$pkg" ] || exit 1
				tar -xzf "$pkg" 2>/dev/null
				[ -f data.tar.gz ] || exit 1
				mkdir -p d && tar -xzf data.tar.gz -C d 2>/dev/null
			fi
			find d -type f -path '*/usr/share/rpcd/acl.d/moci-addon-*.json' -exec cat {} \; 2>/dev/null
			exit 0
		)
		ret=$?
		rm -rf "$tmp"
		exit $ret
		;;
	install)
		valid_name "$1" || { echo "invalid addon name" >&2; exit 1; }
		if [ "$pm" = "apk" ]; then
			apk add "$1"
		else
			opkg install "$1"
		fi
		;;
	remove)
		valid_name "$1" || { echo "invalid addon name" >&2; exit 1; }
		if [ "$pm" = "apk" ]; then
			apk del "$1"
		else
			opkg remove "$1"
		fi
		;;
	*)
		echo "unknown action" >&2
		exit 1
		;;
esac
